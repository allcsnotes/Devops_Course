# {{ ansible_managed }}
APP_ENV={{ app_env | upper }}
APP_HOST={{ inventory_hostname }}
APP_IP={{ ansible_facts['default_ipv4']['address'] }}
WORKERS={{ ansible_facts['processor_vcpus'] * 2 }}
LOG_LEVEL={{ app_log_level }}
CDN_URL={{ app_cdn_url | default('https://cdn.allcsvideos.test') }}
DB_HOST={{ groups['db'] | first }}
DB_NAME={{ hostvars[groups['db'][0]]['db_name'] }}
DB_USER={{ hostvars[groups['db'][0]]['db_user'] }}
DB_PASSWORD={{ hostvars[groups['db'][0]]['db_password'] }}
{% for name, on in app_features.items() %}
FEATURE_{{ name | upper }}={{ on | lower }}
{% endfor %}
