      "description": "Alerts with severity page that Prometheus is firing right now (the ALERTS series).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
