{
  "uid": "allcs-red",
  "title": "allcsvideos · service health (RED)",
  "tags": [
    "allcsvideos",
    "red",
    "team-platform"
  ],
  "description": "Owner: Asha (platform team). For: on-call. Question: is this service working for users right now?",
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-lab"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(http_requests_total, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(http_requests_total, job)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "api",
          "value": "api"
        }
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-lab"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(http_requests_total{job=\"$service\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(http_requests_total{job=\"$service\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#FADE2A",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
