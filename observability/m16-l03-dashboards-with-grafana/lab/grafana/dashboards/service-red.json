          "expr": "100 * (sum(rate(http_requests_total{job=\"$service\", instance=~\"$instance\", route!~\"/health.*\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total{job=\"$service\", instance=~\"$instance\", route!~\"/health.*\"}[$__rate_interval]))",
          "legendFormat": "__auto"
