// Grafana Alloy: read the catalog API containers' stdout and ship it to Loki.
discovery.docker "lab" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=incident-lab"]
  }
}

discovery.relabel "lab" {
  targets = discovery.docker.lab.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "api"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "lab" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.lab.output
  forward_to = [loki.process.lab.receiver]
}

loki.process "lab" {
  stage.json {
    expressions = { level = "level", version = "version", trace_id = "trace_id" }
  }
  stage.labels {
    values = { level = "", version = "" }
  }
  stage.structured_metadata {
    values = { trace_id = "" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
