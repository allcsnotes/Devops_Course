{
 "uid": "catalog-slo",
 "title": "Catalog API \u00b7 SLO",
 "timezone": "Asia/Kolkata",
 "refresh": "5s",
 "schemaVersion": 41,
 "time": {
  "from": "now-20m",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "name": "Deploys",
    "enable": true,
    "iconColor": "#4c9dff",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "deploy"
     ],
     "matchAny": true,
     "limit": 100
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Error ratio (5xx) vs fast-burn threshold 7.2%",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 16,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(http_requests_total{service=\"catalog-api\", status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_requests_total{service=\"catalog-api\"}[1m]))",
     "legendFormat": "error ratio, 1m",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "vector(0.072)",
     "legendFormat": "page threshold (14.4 x 0.5%)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     },
     "min": 0,
     "max": 1,
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "B"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "yellow"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Release running",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (version) (app_build_info)",
     "legendFormat": "{{version}}",
     "instant": true
    }
   ],
   "options": {
    "textMode": "name",
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Requests per second by status",
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_requests_total{service=\"catalog-api\"}[1m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 40,
      "lineWidth": 1
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "500"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "200"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "p95 latency by route",
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket{service=\"catalog-api\"}[1m])))",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ]
}