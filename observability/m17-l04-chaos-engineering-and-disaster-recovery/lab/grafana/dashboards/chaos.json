{
  "uid": "allcs-chaos",
  "title": "allcsvideos \u00b7 SLIs during chaos experiments",
  "tags": [
    "allcsvideos",
    "sli",
    "chaos"
  ],
  "description": "Owner: Asha (platform team). For: whoever runs a chaos experiment. Question: did the steady state hold?",
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#FF9830",
        "name": "chaos experiments",
        "target": {
          "type": "tags",
          "tags": [
            "chaos"
          ],
          "limit": 100,
          "matchAny": true
        },
        "type": "tags"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Availability SLI \u00b7 students, 30 s window",
      "description": "SLO: 99.9 % of requests succeed (lesson 1)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "sli:availability:ratio_rate30s",
          "legendFormat": "availability",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.999
              }
            ]
          },
          "min": 0.9,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "availability"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency SLI \u00b7 p99, students, 30 s window",
      "description": "SLO: 99 % answered within 250 ms (lesson 1)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "sli:latency_p99:30s",
          "legendFormat": "p99",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests / s answered by each API replica",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "h": 11,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "sum by (instance) (rate(http_requests_total{job=\"api\"}[30s]))",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
