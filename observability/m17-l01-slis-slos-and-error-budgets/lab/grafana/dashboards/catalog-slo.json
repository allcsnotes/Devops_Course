{
  "uid": "allcs-slo",
  "title": "allcsvideos · catalog API SLO",
  "tags": [
    "allcsvideos",
    "slo",
    "team-platform"
  ],
  "description": "Owner: Asha (platform team). SLO: 99.9 % of GET /api/courses succeed, rolling 30 days. Policy: docs/error-budget-policy.md",
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#FADE2A",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability · 30 days",
      "description": "SLI: good / valid requests. SLO 99.9 %",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "job:slo_availability:ratio_rate30d{job=\"api\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget left",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "job:slo_error_budget:remaining_ratio30d{job=\"api\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bad requests left",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "0.001 * job:slo_requests:increase30d{job=\"api\"} - job:slo_errors:increase30d{job=\"api\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Burn rate · 1 h",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "job:slo_burn_rate:1h{job=\"api\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:x",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Burn rate · 5 m",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "job:slo_burn_rate:5m{job=\"api\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:x",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Page alert",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "max(ALERTS{alertname=\"CatalogErrorBudgetBurn\", severity=\"page\", alertstate=\"firing\"}) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "quiet"
                },
                "1": {
                  "text": "FIRING"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Burn rate (1 = budget lasts exactly 30 days)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 15,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "job:slo_burn_rate:5m{job=\"api\"}",
          "legendFormat": "5 m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "job:slo_burn_rate:1h{job=\"api\"}",
          "legendFormat": "1 h"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "job:slo_burn_rate:6h{job=\"api\"}",
          "legendFormat": "6 h"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:x",
          "min": 0.01,
          "max": 1000,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "axisSoftMin": 0.01,
            "axisSoftMax": 1000
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5 m"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8AB8FF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "1 h"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "6 h"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B877D9"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error budget left · 30 days",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 15,
        "y": 5,
        "w": 9,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "job:slo_error_budget:remaining_ratio30d{job=\"api\"}",
          "legendFormat": "budget left"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Bad requests per hour · last 30 days",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "timeFrom": "30d",
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-lab"
          },
          "expr": "sum(increase(http_requests_total{job=\"api\", route=\"/api/courses\", status=~\"5..\"}[1h]))",
          "legendFormat": "bad requests",
          "interval": "1h"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2495C"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "barAlignment": 0
          }
        },
        "overrides": []
      }
    }
  ]
}