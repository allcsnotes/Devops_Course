# syntax=docker/dockerfile:1
# v2: two stages - build with the JDK + Maven, run on a JRE
FROM maven:3.9.16-eclipse-temurin-25 AS build
WORKDIR /src
COPY pom.xml .
COPY gateway/pom.xml gateway/
RUN mvn -B -f gateway/pom.xml dependency:go-offline
COPY gateway/src gateway/src
RUN mvn -B -DskipTests -f gateway/pom.xml package

FROM eclipse-temurin:25.0.4.1_1-jre
WORKDIR /app
COPY --from=build /src/gateway/target/gateway-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
