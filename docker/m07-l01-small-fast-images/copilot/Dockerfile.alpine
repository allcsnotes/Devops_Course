# syntax=docker/dockerfile:1
# the same multi-stage shape on Alpine (musl libc instead of glibc)
FROM python:3.12.15-alpine3.23 AS build
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM python:3.12.15-alpine3.23
ENV PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH \
    COURSE_INDEX=/app/data/courses.json
RUN addgroup -g 10001 copilot \
 && adduser -u 10001 -G copilot -H -D copilot
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY app/ app/
COPY data/ data/
COPY docker-entrypoint.sh .
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://localhost:8000/health', timeout=2)"]
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
