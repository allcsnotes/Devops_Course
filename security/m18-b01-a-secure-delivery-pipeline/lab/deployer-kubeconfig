#!/bin/bash
# deployer-kubeconfig : a kubeconfig for the prod deployer service account (lab helper; the token is never printed).
# Token lifetime 48 hours (kubectl create token): short-lived, and scoped by the deployer Role to the prod namespace.
set -euo pipefail
server=https://securepipe-control-plane:6443
ca=$(kubectl config view --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')
token=$(kubectl create token deployer -n prod --duration=48h)
cat <<YAML
apiVersion: v1
kind: Config
clusters: [{name: lab, cluster: {server: $server, certificate-authority-data: $ca}}]
users: [{name: deployer, user: {token: $token}}]
contexts: [{name: deployer@lab, context: {cluster: lab, user: deployer, namespace: prod}}]
current-context: deployer@lab
YAML
