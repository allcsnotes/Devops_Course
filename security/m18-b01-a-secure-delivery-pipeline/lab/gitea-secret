#!/bin/bash
# gitea-secret NAME [REPO] < value : stores a Gitea Actions secret through the REST API (lab helper, never prints it)
# The value is read from standard input; Gitea encrypts it and never shows it again, in the UI or in job logs.
set -euo pipefail
name=$1; repo=${2:-allcsvideos/allcsvideos-platform}
jq -Rs '{data: .}' | curl -s -o /dev/null -w "$name: HTTP %{http_code}\n" -X PUT \
  -H "Authorization: token $(cat ~/.gitea-token)" -H 'Content-Type: application/json' \
  --data-binary @- "http://gitea:3000/api/v1/repos/$repo/actions/secrets/$name"
