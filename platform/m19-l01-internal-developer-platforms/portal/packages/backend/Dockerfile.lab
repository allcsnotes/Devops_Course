# allcsvideos-portal:1.0 - the allcsvideos portal (Backstage 1.56.0, create-app 0.9.3), built once for the lab.
# Same recipe as the packages/backend/Dockerfile that create-app writes (host build: yarn install, yarn tsc,
# yarn build:backend, then copy the bundle), with one change: FROM node:22.23.3-slim, the Node version the build
# used (the generated file says "FROM node:24-trixie-slim" and warns that mismatched versions break native modules).
# Build from the portal's root folder:  docker build -f packages/backend/Dockerfile.lab -t allcsvideos-portal:1.0 .
FROM node:22.23.3-slim
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev && rm -rf /var/lib/apt/lists/*
USER node
WORKDIR /app
COPY --chown=node:node .yarn ./.yarn
COPY --chown=node:node .yarnrc.yml ./
COPY --chown=node:node backstage.json ./
ENV NODE_ENV=production
COPY --chown=node:node yarn.lock package.json packages/backend/dist/skeleton.tar.gz ./
RUN tar xzf skeleton.tar.gz && rm skeleton.tar.gz
RUN yarn workspaces focus --all --production && rm -rf "$(yarn cache clean)"
COPY --chown=node:node packages/backend/dist/bundle.tar.gz app-config*.yaml ./
RUN tar xzf bundle.tar.gz && rm bundle.tar.gz
LABEL course=devops lab=idp
CMD ["node", "packages/backend", "--config", "app-config.yaml", "--config", "app-config.lab.yaml"]
